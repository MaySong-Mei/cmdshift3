# Optional real AI. Leave the key blank for clearly labeled manual review.
# DeepSeek Flash accepts screenshots and text via Chat Completions.
CMD3_AI_PROVIDER=deepseek
CMD3_AI_API_KEY=
CMD3_AI_MODEL=deepseek-flash
CMD3_AI_BASE_URL=https://api.deepseek.com/v1
# Optional output language; English overrides the input language for AI text.
CMD3_AI_OUTPUT_LANGUAGE=English
# Existing OpenAI support: provider=openai, model=gpt-4.1-mini,
# base URL=https://api.openai.com/v1 (Responses API).
# Anthropic support: provider=anthropic, model=<available Claude model ID>,
# base URL=https://api.anthropic.com/v1 (native Messages API).
# Multi-workspace personal keys also require this optional workspace header.
CMD3_AI_WORKSPACE_ID=

# Optional Keewano ingestion. No sponsor claims until live write/query verified.
KEEWANO_API_KEY=
KEEWANO_PAT=
KEEWANO_PROJECT_ID=

# Demo server. .data is ignored by Git.
CMD3_HOST=127.0.0.1
CMD3_PORT=4317
CMD3_DATA_DIR=.data
